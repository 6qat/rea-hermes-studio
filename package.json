{
  "name": "rea-hermes-studio",
  "version": "0.6.28",
  "private": true,
  "description": "Hermes Studio plugin — full feature and visual parity with VSCode Hermes Studio",
  "author": "Guilherme Ceschiatti (6qat)",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "release": "bash scripts/release.sh",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "obsidian": "^1.14.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
